# Copy this file to .env.local and fill in the values from
# Firebase Console → Project settings → Your apps → CollabStorytelling → Config.
# .env.local is git-ignored, so your real values are never committed.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=collab-storytelling-379cb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Supabase ---
# Get these from Supabase -> Project Settings -> API Keys.
# For NEXT_PUBLIC_SUPABASE_ANON_KEY use the PUBLISHABLE key (starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Server-only. Never expose this key through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Development only: a test teacher's user id (from Supabase -> Authentication -> Users),
# used by the R14 Teacher Review page until login (Supabase Auth) is connected.
NEXT_PUBLIC_DEV_TEACHER_ID=

# Tip: run the app with `npm run dev:web` if `npm run dev` fails on the Firebase emulator.
