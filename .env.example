# Copy this file to .env.local and fill in the values from
# Firebase Console → Project settings → Your apps → CollabStorytelling → Config.
# .env.local is git-ignored, so your real values are never committed.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=collab-storytelling-379cb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
